; DRE Visualizations — copied from DRE-theme's .editorconfig, so the three
; repositories share one baseline (UTF-8, LF, final newline, spaces). Only the
; sections below the baseline differ, and each records this tree's existing
; convention rather than a new one: the browser JavaScript, PHP and CSS use four
; spaces; the Node tooling (.mjs), JSON and the workflows use two.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{scss,css}]
indent_size = 4

[*.js]
indent_size = 4

[*.{mjs,json,yml,yaml}]
indent_size = 2

[*.md]
; Markdown uses trailing double-space for hard line breaks.
trim_trailing_whitespace = false

[*.ini]
indent_style = space
indent_size = 4

[*.pot]
; Generated by scripts/extract-translations.mjs.
trim_trailing_whitespace = false
