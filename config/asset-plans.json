{
  "$comment": "What each surface loads. Read by src/View/Helper/DashboardAssets.php (PHP) and scripts/build-frontend-bundles.mjs / the contract checks (Node), so the order lives in one place. Paths are relative to asset/. A plan names a stylesheet flag, the library URLs it hands the core for lazy loading (`publish`, keys of `libs`), and its scripts in load order: a path, `@group` (a list in `groups`) or `lib:key` (a vendored library loaded eagerly). `after` emits another plan first. Every plan is emitted at most once per request; scripts are de-duplicated by URL. See docs/ARCHITECTURE.md.",
  "stylesheet": "css/dre-visualizations.min.css",
  "libs": {
    "echarts": "vendor/echarts.min.js",
    "wordcloud": "vendor/echarts-wordcloud.min.js",
    "maplibre": "vendor/maplibre-gl.js",
    "maplibreWorker": "vendor/maplibre-gl-worker.js",
    "maplibreCss": "vendor/maplibre-gl.css",
    "d3": [
      "vendor/d3-quadtree.min.js",
      "vendor/d3-dispatch.min.js",
      "vendor/d3-timer.min.js",
      "vendor/d3-force.min.js"
    ]
  },
  "chartSources": [
    "js/dashboard-layouts.js",
    "js/dashboard-charts-timeline.js",
    "js/dashboard-charts-pie.js",
    "js/dashboard-charts-bar.js",
    "js/dashboard-charts-histogram.js",
    "js/dashboard-charts-wordcloud.js",
    "js/dashboard-charts-gantt.js",
    "js/dashboard-charts-heatmap.js",
    "js/dashboard-charts-chord.js",
    "js/dashboard-charts-sankey.js",
    "js/dashboard-charts-sunburst.js",
    "js/dashboard-charts-stacked-timeline.js",
    "js/dashboard-charts-beeswarm.js",
    "js/dashboard-charts-map.js",
    "js/dashboard-charts-cluster-map.js",
    "js/dashboard-charts-affiliation-map.js",
    "js/dashboard-collab-network.js",
    "js/dashboard-charts-contributor-network.js",
    "js/dashboard-charts-stacked-area.js",
    "js/dashboard-charts-treemap.js",
    "js/dashboard-charts-choropleth.js",
    "js/dashboard-charts-radar.js",
    "js/dashboard-charts-communities.js",
    "js/dashboard-charts-boxplot.js",
    "js/dashboard-charts-time-chord.js",
    "js/dashboard-charts-semantic.js",
    "js/dashboard-stat-cards.js",
    "js/dashboard-registry.js"
  ],
  "groups": {
    "core": ["js/dashboard-core.min.js"],
    "chartBundle": ["js/dashboard-charts.bundle.min.js"],
    "graphRenderer": ["js/graph-canvas.js", "js/graph-force.js", "js/graph-chrome.js"],
    "knowledgeGraph": ["js/knowledge-graph-data.js", "js/knowledge-graph-ui.js", "js/item-location-map.js", "js/knowledge-graph.js"],
    "entityGraph": ["js/entity-graph-ui.js", "js/entity-graph.js"]
  },
  "plans": {
    "prelude": {
      "stylesheet": true,
      "publish": ["echarts", "wordcloud", "maplibre", "maplibreWorker", "maplibreCss", "d3"],
      "scripts": ["@core"]
    },
    "dashboard": {
      "after": "prelude",
      "scripts": ["@graphRenderer", "@chartBundle", "js/dashboard.js"]
    },
    "explorer": {
      "after": "prelude",
      "scripts": ["@graphRenderer", "@chartBundle", "js/dashboard.js", "js/dashboard-explorer.js"]
    },
    "compare": {
      "after": "prelude",
      "scripts": ["@graphRenderer", "@chartBundle", "js/dashboard-compare-unify.js", "js/dashboard-compare.js"]
    },
    "network": {
      "stylesheet": true,
      "publish": ["maplibre", "maplibreWorker", "maplibreCss"],
      "scripts": ["lib:echarts", "lib:wordcloud", "lib:d3", "@core", "@graphRenderer", "@chartBundle", "js/dashboard-network-explorer.js"]
    },
    "whatsNew": {
      "stylesheet": true,
      "publish": ["maplibre", "maplibreWorker", "maplibreCss"],
      "scripts": ["lib:echarts", "lib:wordcloud", "lib:d3", "@core", "@graphRenderer", "@chartBundle", "js/dashboard-whats-new.js"]
    },
    "entityGraph": {
      "stylesheet": true,
      "publish": ["maplibre", "maplibreWorker", "maplibreCss"],
      "scripts": ["@core", "@entityGraph"]
    },
    "spatial": {
      "stylesheet": true,
      "publish": ["maplibre", "maplibreWorker", "maplibreCss"],
      "scripts": ["@core", "js/spatial-exploration.js"]
    },
    "semanticMap": {
      "stylesheet": true,
      "publish": ["echarts"],
      "scripts": ["@core", "js/semantic-map.js"]
    },
    "knowledgeGraph": {
      "after": "prelude",
      "scripts": ["@graphRenderer", "@knowledgeGraph"]
    },
    "siblingSparkline": {
      "after": "prelude",
      "scripts": ["js/sibling-sparkline.js"]
    },
    "similarItems": {
      "after": "prelude",
      "scripts": ["js/semantic-similar.js"]
    },
    "featuredCollections": {
      "stylesheet": true,
      "scripts": ["@core"]
    },
    "photoBrowse": {
      "stylesheet": true,
      "scripts": ["@core", "js/item-set-photo-views.js"]
    },
    "embedFrame": {
      "scripts": ["js/embed-height.js"]
    },
    "embedGallery": {
      "after": "dashboard",
      "scripts": ["js/embed-gallery.js"]
    }
  }
}
