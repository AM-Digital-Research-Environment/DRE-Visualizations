<?php
/**
 * Admin maintenance page for DreVisualizations.
 *
 * One CSRF-protected form with two buttons: "Regenerate" dispatches the
 * precompute background job, "Withdraw" (formaction) stops serving the
 * published snapshot. Plain server-rendered HTML; the flash messenger
 * (rendered by the admin layout) links to the job log once dispatched.
 *
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var \DreVisualizations\Form\MaintenanceForm $form
 * @var array{id:int,title:string,slug:string}|null $scopeSite
 * @var array{state:string,createdAt:?string,changedAt:int} $publication
 * @var array<int,string> $placements Site id => ResourcePagePlacement::STATE_*
 */

$translate = $this->plugin('translate');

$form->setAttribute('action', $this->url('admin/dre-visualizations/maintenance-regenerate'));
$form->setAttribute('method', 'POST');
$form->prepare();

echo $this->pageTitle($translate('DRE Visualizations: maintenance'), 1);
?>

<p class="description">
    <?= $translate('Rebuild all precomputed visualisation data directly from the Omeka database — no shell access or external tools required. Runs as a background job; track progress in the Jobs admin page.') ?>
</p>

<div style="margin-top:1.5rem;max-width:640px;">
    <section style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;background:#fff;">
        <h3 style="margin-top:0;"><?= $translate('Regenerate dashboard data') ?></h3>
        <?php if ($scopeSite): ?>
            <p>
                <strong><?= $translate('Publication scope:') ?></strong>
                <?= $this->escapeHtml($scopeSite['title']) ?>
                <code>#<?= (int) $scopeSite['id'] ?></code>.
                <?= $translate('Only public items assigned to this public site, including relationship targets and media, enter generated JSON.') ?>
            </p>
        <?php else: ?>
            <div class="messages warning">
                <?= $translate('No canonical public site is configured. Open this module’s configuration, select a public site, and save before regenerating data.') ?>
            </div>
        <?php endif; ?>
        <p>
            <?= $translate('Regenerates every precomputed artefact: per-entity dashboards (sections, projects, people, institutions, locations, subjects), category overviews, the collection overview, the Discursive Communities graph, and the per-country choropleth index.') ?>
        </p>
        <?php
        $created = $publication['createdAt'] ? $this->i18n()->dateFormat(new DateTime($publication['createdAt']), 'medium', 'short') : '';
        $changed = $publication['changedAt'] ? $this->i18n()->dateFormat((new DateTime())->setTimestamp($publication['changedAt']), 'medium', 'short') : '';
        $statusText = match ($publication['state']) {
            'current' => sprintf($translate('Published data is up to date (generated %s).'), $created),
            'stale' => sprintf($translate('Published data was generated %1$s and stays online. Edits since %2$s are not in it yet; it refreshes automatically once edits have been quiet for five minutes.'), $created, $changed),
            'withdrawn-private' => $translate('An edit made something private, so the visualisations are hidden. They are regenerated automatically once edits have been quiet for a minute.'),
            'withdrawn' => $translate('Publication was withdrawn. The visualisations stay hidden until you click Regenerate now.'),
            default => $translate('Nothing is published yet. Click Regenerate now to publish the visualisations.'),
        };
        ?>
        <p>
            <strong><?= $translate('Status:') ?></strong>
            <?= $this->escapeHtml($statusText) ?>
        </p>
        <p>
            <strong><?= $translate('When to run:') ?></strong>
            <?= $translate('Only when you want the visualisations updated straight away. After an edit or import, the published data stays online and refreshes in the background once edits have been quiet for five minutes. Making an item, medium, item set or value private hides the visualisations until that refresh.') ?>
        </p>
        <?= $this->form()->openTag($form) ?>
            <?= $this->formCollection($form) ?>
            <button type="submit" class="button" style="margin-top:0.5rem;"<?= $scopeSite ? '' : ' disabled' ?>>
                <?= $translate('Regenerate now') ?>
            </button>
            <button type="submit" formaction="<?= $this->escapeHtmlAttr($this->url('admin/dre-visualizations/maintenance-withdraw')) ?>"><?= $translate('Withdraw published data') ?></button>
        <?= $this->form()->closeTag() ?>
    </section>
</div>

<?php $sites = $this->api()->search('sites')->getContent(); ?>
<?php if ($sites): ?>
<div style="margin-top:1.5rem;max-width:640px;">
    <section style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;background:#fff;">
        <h3 style="margin-top:0;"><?= $translate('Visualisations on item pages') ?></h3>
        <p>
            <?= $translate('The Visualisations block shows a dashboard on the page of every item that has one: research projects, sections, people, institutions, places and subjects. A site whose item pages were never configured shows it by default. Once a site saves its Resource pages settings, only the blocks listed there appear; this module adds the Visualisations to that list when it is installed or upgraded, after the record’s own blocks.') ?>
        </p>
        <ul>
            <?php foreach ($sites as $site): ?>
                <?php
                $placement = $placements[$site->id()] ?? 'default';
                $placementText = match ($placement) {
                    'present' => $translate('Item pages show the Visualisations.'),
                    'missing' => $translate('Item pages are configured without the Visualisations.'),
                    default => $translate('Item pages use the default blocks, which include the Visualisations.'),
                };
                ?>
                <li style="margin-bottom:0.35rem;">
                    <a href="<?= $this->escapeHtmlAttr($this->url('admin/site/slug/action', ['site-slug' => $site->slug(), 'action' => 'theme-resource-pages'])) ?>"><?= $this->escapeHtml($site->title()) ?></a>:
                    <?= $this->escapeHtml($placementText) ?>
                </li>
            <?php endforeach; ?>
        </ul>
        <p>
            <?= $translate('Run this again after removing the block by mistake. It changes only sites you can edit, leaves every other block where it is, and does nothing where the block is already present.') ?>
        </p>
        <?= $this->form()->openTag($form) ?>
            <?= $this->formCollection($form) ?>
            <button type="submit" formaction="<?= $this->escapeHtmlAttr($this->url('admin/dre-visualizations/maintenance-place-block')) ?>"><?= $translate('Add the Visualisations block to item pages') ?></button>
        <?= $this->form()->closeTag() ?>
    </section>
</div>

<div style="margin-top:1.5rem;max-width:640px;">
    <section style="border:1px solid #ddd;border-radius:6px;padding:1.5rem;background:#fff;">
        <h3 style="margin-top:0;"><?= $translate('Embed visualisations') ?></h3>
        <p>
            <?= $translate('Each site has a public embed gallery with copy-paste iframe snippets for every visualisation block — and, for dashboards, for each individual chart. Open it to preview a block and grab its code.') ?>
        </p>
        <ul>
            <?php foreach ($sites as $site): ?>
                <li style="margin-bottom:0.35rem;">
                    <a href="<?= $this->escapeHtmlAttr($this->url('site/dre-embed', ['site-slug' => $site->slug()])) ?>" target="_blank" rel="noopener">
                        <?= $this->escapeHtml($site->title()) ?>
                    </a>
                    <code style="margin-left:0.5rem;font-size:0.85em;color:#666;">/s/<?= $this->escapeHtml($site->slug()) ?>/dre-embed</code>
                </li>
            <?php endforeach; ?>
        </ul>
    </section>
</div>
<?php endif; ?>
