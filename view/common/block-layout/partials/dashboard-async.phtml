<?php
/**
 * Shared async-dashboard container — the markup for every dashboard block:
 * the site-page dashboards (Collection Overview / Collection Dashboard /
 * Publications / Podcasts / YouTube) and the resource-page dashboards (linked
 * items, item set). Injects the dashboard asset chain and emits the container
 * the orchestrator (dashboard.js) hydrates from the precomputed JSON named by
 * data-item-id, through the one async-surface partial every block shares.
 *
 * Params:
 *   string  $itemId        Precomputed artifact id (e.g. 'publications',
 *                          'collection-overview', or a resource id).
 *   ?string $slug          Embed slug (data-embed-slug — must match the
 *                          EmbedController BLOCKS key so copy-embed buttons
 *                          work); omitted for resource-page dashboards.
 *   ?string $layout        Optional layout override (data-layout), e.g.
 *                          'collectionOverview' — otherwise the JSON's
 *                          resourceType picks the layout.
 *   ?string $title         Optional embed title override (data-title).
 *   ?string $dashboardDir  Optional artifact directory (data-dashboard-dir).
 *   array   $assets        Options for the dashboardAssets helper (default
 *                          ['cdn' => true]: a site-page block, where Module.php
 *                          has not injected the chart prelude).
 *
 * Zero-config: no $block access, so the bare embed route renders it too.
 *
 * @var \Laminas\View\Renderer\PhpRenderer $this
 */

// Single source of truth for the asset chain: the DashboardAssets view helper.
$this->dashboardAssets($assets ?? ['cdn' => true]);
?>

<div class="resource-vis-block dashboard-block">
    <?= $this->partial('common/block-layout/partials/async-surface', [
        'class' => 'dashboard-async-container',
        'statusInside' => true,
        'data' => [
            'item-id' => (string) $itemId,
            'layout' => $layout ?? null,
            'embed-slug' => $slug ?? null,
            'title' => $title ?? null,
            'dashboard-dir' => $dashboardDir ?? null,
            'ready-status' => $this->translate('Visualisations ready.'),
            'empty-status' => $this->translate('No visualisations are available.'),
            'error-status' => $this->translate('The visualization could not be loaded.'),
        ],
    ]) ?>
</div>
