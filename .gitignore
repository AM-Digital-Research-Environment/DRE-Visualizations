.DS_Store
*.swp
*.swo
*~
node_modules/
.idea/
.vscode/
__pycache__/
.codex/

# Per-item knowledge-graph JSON (~6,000 files, ~188 MB) is regenerated in-Omeka
# via the admin "Regenerate now" job — not committed. These legacy public paths
# stay ignored; current snapshots live in private storage.
asset/data/knowledge-graphs/

# Per-item-set photo-gallery JSON is install-specific (media storage hashes) and
# regenerated in-Omeka by the same job. Blocks require a current published
# snapshot before displaying their generated data.
asset/data/photo-galleries/
asset/data/item-set-dashboards/
asset/data/generations/
asset/data/current.json
asset/data/.generate-site-*.lock

# Per-item + collection dashboard JSON (~2,500 files, ~17 MB), the
# {type}-index.json / beeswarm / what's-new artefacts, and the discursive-
# communities graph are all install-specific and rebuilt in-Omeka by the same
# "Regenerate now" job — not committed. The dashboard / communities blocks
# render empty until it has run once. The static geo/countries.geojson INPUT is
# not generated and stays committed.
asset/data/item-dashboards/
asset/data/communities/

# Additional install-specific outputs from the same precompute job.
asset/data/network-explorer.json
asset/data/featured-collections/

# Legacy semantic cache/release paths stay ignored. Scoped derived inputs live
# under data/embeddings; full vectors remain outside the repository by default.
asset/data/embeddings/cache.json
asset/data/embeddings/release/

/.cache/

# Playwright output (npm run test:browser).
/test-results/
/playwright-report/
